# .env.example — Copy this to .env and fill in your values
# Do NOT commit .env to version control

# Required for sending application emails via Resend (resend.com)
RESEND_API_KEY=your_resend_api_key_here

# Destination email for applications (on Resend free tier, must be your verified email)
APPLY_TO_EMAIL=your@email.com

# Optional: Powers AI recruiter simulation via ASI:One (asi1.ai)
# Without this, falls back to built-in rule-based personas
ASI1_API_KEY=your_asi1_api_key_here

# Applicant details (customize to match your profile)
APPLICANT_NAME=Your Name
APPLICANT_SKILLS=python,react,next.js,sql,javascript
APPLICANT_LINKS=GitHub: https://github.com/yourusername
APPLICANT_PORTFOLIO=https://yourportfolio.com
APPLICANT_BIO=B.Tech CSE student with experience in web development and AI.

# Only needed for the multi-agent local setup (not required for hosted agentverse_agent.py)
GROQ_API_KEY=your_groq_api_key_here
SERPAPI_KEY=your_serpapi_key_here
MATCHER_ADDRESS=
TRACKER_ADDRESS=
MAILER_ADDRESS=
WRITER_ADDRESS=
